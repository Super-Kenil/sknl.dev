---
import { SOCIAL_LINKS } from '../consts';

const githubUsername = SOCIAL_LINKS.github.slice(SOCIAL_LINKS.github.lastIndexOf('/') + 1);
const apiUrl = `https://github-contributions-api.jogruber.de/v4/${githubUsername}?y=last`;
---

<section class='w-full max-w-3xl mx-auto' aria-labelledby='github-activity-title'>
  <h2 id='github-activity-title' class='text-sm font-semibold'>GitHub activity</h2>
  <div data-github-contributions data-api-url={apiUrl} data-username={githubUsername}>
    <div class='mt-3 rounded-box border border-base-300 p-3'>
      <div
        class='overflow-x-auto pb-1'
        role='region'
        aria-label='Weekly GitHub contributions. Scroll horizontally to explore dates.'
      >
        <div class='contribution-calendar'>
          <div class='contribution-months' data-contribution-months aria-hidden='true'></div>
          <div
            class='contribution-grid'
            data-contribution-grid
            role='group'
            tabindex='0'
            aria-describedby='github-contribution-tooltip'
            aria-keyshortcuts='ArrowUp ArrowDown ArrowLeft ArrowRight'
            aria-label={`Loading contribution activity for ${githubUsername}`}
          ></div>
        </div>
      </div>
      <div class='mt-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-2'>
        <p class='text-xs opacity-70' data-contribution-status role='status'>
          Loading GitHub contributions…
        </p>
        <div
          class='contribution-legend'
          role='img'
          aria-label='Contribution intensity, from less to more'
        >
          <span>Less</span>
          <span class='contribution-swatch' data-level='0' aria-hidden='true'></span>
          <span class='contribution-swatch' data-level='1' aria-hidden='true'></span>
          <span class='contribution-swatch' data-level='2' aria-hidden='true'></span>
          <span class='contribution-swatch' data-level='3' aria-hidden='true'></span>
          <span class='contribution-swatch' data-level='4' aria-hidden='true'></span>
          <span>More</span>
        </div>
      </div>
    </div>
    <p class='sr-only' data-day-announcement role='status' aria-live='polite'></p>
    <div
      id='github-contribution-tooltip'
      class='contribution-tooltip'
      data-contribution-tooltip
      role='tooltip'
      hidden
    ></div>
  </div>
  <a
    href={SOCIAL_LINKS.github}
    class='link link-hover mt-2 inline-block text-xs opacity-70'
    target='_blank'
    rel='noopener noreferrer'
    aria-label='View GitHub profile'
  >
    View GitHub profile
  </a>
</section>

{/*
  ghchart.rshah.org fallback:
  <img src="https://ghchart.rshah.org/Super-Kenil" alt="GitHub contributions for Super Kenil" />
*/}

<script>
  import { loadGitHubContributions } from '../scripts/github-contributions';

  function initializeContributionChart() {
    const container = document.querySelector<HTMLElement>('[data-github-contributions]');
    if (container) void loadGitHubContributions(container);
  }

  document.addEventListener('astro:page-load', initializeContributionChart);
  initializeContributionChart();
</script>

<style>
  .contribution-calendar {
    --contribution-cell-size: 0.625rem;
    --contribution-gap: 3px;
    width: max-content;
  }

  .contribution-months {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: var(--contribution-cell-size);
    gap: var(--contribution-gap);
    min-height: 1rem;
    color: var(--color-base-content);
    font-size: 0.625rem;
    line-height: 1rem;
    opacity: 0.7;
  }

  :global(.contribution-month-label) {
    white-space: nowrap;
  }

  .contribution-grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: var(--contribution-cell-size);
    grid-template-rows: repeat(7, var(--contribution-cell-size));
    gap: var(--contribution-gap);
    width: max-content;
  }

  .contribution-grid:focus-visible {
    outline: none;
  }

  .contribution-tooltip {
    position: fixed;
    z-index: 1000;
    max-width: calc(100vw - 1rem);
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--color-base-300);
    border-radius: 0.5rem;
    background: var(--color-base-100);
    color: var(--color-base-content);
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.2);
    font-size: 0.75rem;
    line-height: 1rem;
    white-space: nowrap;
    pointer-events: none;
    transform: translateX(-50%);
  }

  :global(.contribution-day) {
    display: block;
    width: var(--contribution-cell-size);
    height: var(--contribution-cell-size);
    border-radius: 2px;
    cursor: help;
  }

  :global(.contribution-day[data-level='0']) {
    background: var(--color-base-300);
  }

  :global(.contribution-day[data-level='1']) {
    background: color-mix(in srgb, var(--color-success) 40%, var(--color-base-100));
  }

  :global(.contribution-day[data-level='2']) {
    background: color-mix(in srgb, var(--color-success) 60%, var(--color-base-100));
  }

  :global(.contribution-day[data-level='3']) {
    background: color-mix(in srgb, var(--color-success) 80%, var(--color-base-100));
  }

  :global(.contribution-day[data-level='4']) {
    background: var(--color-success);
  }

  :global(.contribution-day[data-active='true']) {
    outline: 2px solid var(--color-primary);
    outline-offset: 1px;
  }

  .contribution-legend {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 3px;
    color: var(--color-base-content);
    font-size: 0.625rem;
    opacity: 0.7;
  }

  :global(.contribution-swatch) {
    display: block;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 2px;
  }

  :global(.contribution-swatch[data-level='0']) {
    background: var(--color-base-300);
  }

  :global(.contribution-swatch[data-level='1']) {
    background: color-mix(in srgb, var(--color-success) 40%, var(--color-base-100));
  }

  :global(.contribution-swatch[data-level='2']) {
    background: color-mix(in srgb, var(--color-success) 60%, var(--color-base-100));
  }

  :global(.contribution-swatch[data-level='3']) {
    background: color-mix(in srgb, var(--color-success) 80%, var(--color-base-100));
  }

  :global(.contribution-swatch[data-level='4']) {
    background: var(--color-success);
  }
</style>
