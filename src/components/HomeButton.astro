---
import {Icon} from 'astro-icon/components';

interface Props {
  className?: string;
  href?: string;
  label?: string;
}

const {className = '', href = '/', label = 'Back'} = Astro.props;
---

<a href={href} title={`${label} (Backspace)`} class={`link link-hover flex items-center gap-x-2 text-sm${className !== '' ? ` ${className}` : ''}`}>
  <Icon name='lucide:arrow-left' size={16} aria-hidden='true' /> {label} <kbd class='kbd kbd-xs' aria-hidden='true'>Backspace</kbd>
</a>
