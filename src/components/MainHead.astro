---
import '../styles/global.css';

type Props = {
	title?: string | undefined;
	description?: string | undefined;
	ogType?: 'website' | 'article' | undefined;
	ogImage?: string | undefined;
	articleData?: {
		publishDate: Date;
		tags?: string[];
		author?: string;
	} | undefined;
}

const {
	title = 'Super Kenil (Kenil Sudani)',
	description = 'A developer from Gujarat, India. Building tools that solve real problems.',
	ogType = 'website',
	ogImage = '/og-image.webp',
	articleData,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://sknl.dev');
const siteURL = 'https://sknl.dev';

// JSON-LD structured data
let jsonLD: any = {
	"@context": "https://schema.org",
	"@type": "Person",
	"name": "Kenil Sudani",
	"alternateName": "Super Kenil",
	"url": siteURL,
	"jobTitle": "Developer",
	"worksFor": {
		"@type": "Organization",
		"name": "Freelance"
	},
	"sameAs": [
		"https://github.com/Super-Kenil",
		"https://x.com/super_kenil",
		"https://linkedin.com/in/super-kenil",
		"https://bsky.app/profile/sknl.dev",
		"https://www.npmjs.com/~super-kenil"
	],
	"address": {
		"@type": "PostalAddress",
		"addressRegion": "Gujarat",
		"addressCountry": "India"
	}
};

if (ogType === 'article' && articleData) {
	jsonLD = {
		"@context": "https://schema.org",
		"@type": "BlogPosting",
		"headline": title,
		"description": description,
		"author": {
			"@type": "Person",
			"name": articleData.author || "Kenil Sudani",
			"url": siteURL
		},
		"datePublished": articleData.publishDate.toISOString(),
		"url": canonicalURL.toString(),
		"mainEntityOfPage": {
			"@type": "WebPage",
			"@id": canonicalURL.toString()
		},
		"publisher": {
			"@type": "Person",
			"name": "Kenil Sudani",
			"url": siteURL
		}
	};
}
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />
<meta name="robots" content="index, follow" />
<meta name="googlebot" content="index, follow" />
<meta name="theme-color" content="#1a1a2e" />
<meta name="color-scheme" content="light dark" />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content="Kenil Sudani" />
<meta name="keywords" content="Kenil Sudani, Super Kenil, developer, full-stack, Gujarat, India, JavaScript, TypeScript, web development" />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="Super Kenil" />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={new URL(ogImage, siteURL)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />

{ogType === 'article' && articleData && (
    <>
        <meta property="article:published_time" content={articleData.publishDate.toISOString()} />
        {articleData.author && <meta property="article:author" content={articleData.author} />}
        {articleData.tags?.map(tag => (
            <meta property="article:tag" content={tag} />
        ))}
    </>
)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@super_kenil" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(ogImage, siteURL)} />
<meta name="twitter:creator" content="@super_kenil" />

<!-- Favicon & Icons -->
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/favicon.ico" />

<!-- Sitemap & Discovery -->
<link rel="sitemap" type="application/xml" href="/sitemap.xml" />
<link rel="author" href="/llms.txt" />

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLD)} />

<link
	id="daisyui-theme"
	rel="stylesheet"
	href="https://cdn.jsdelivr.net/npm/daisyui@5/theme/garden.css"
	data-astro-transition-persist="theme-link"
/>

<script is:inline>
	const DAISYUI_THEMES = [
		'abyss', 'acid', 'aqua', 'autumn', 'black', 'bumblebee', 'business',
		'caramellatte', 'cmyk', 'coffee', 'corporate', 'cupcake', 'cyberpunk',
		'dark', 'dim', 'dracula', 'emerald', 'fantasy', 'forest', 'garden',
		'halloween', 'lemonade', 'light', 'lofi', 'luxury', 'night', 'nord',
		'pastel', 'retro', 'silk', 'sunset', 'synthwave', 'valentine', 'winter', 'wireframe'
	];

	function applyTheme(theme) {
		const themeLink = document.getElementById('daisyui-theme');
		if (themeLink) {
			themeLink.href = `https://cdn.jsdelivr.net/npm/daisyui@5/theme/${theme}.css`;
		}
		document.documentElement.setAttribute('data-theme', theme);
		window.currentTheme = theme;
	}

	function initTheme() {
		const savedTheme = localStorage.getItem('savedTheme');
		if (savedTheme && DAISYUI_THEMES.includes(savedTheme)) {
			applyTheme(savedTheme);
			return;
		}

		if (window.currentTheme && DAISYUI_THEMES.includes(window.currentTheme)) {
			applyTheme(window.currentTheme);
			return;
		}

		const randomTheme = DAISYUI_THEMES[Math.floor(Math.random() * DAISYUI_THEMES.length)];
		applyTheme(randomTheme);
	}

	initTheme();

	document.addEventListener('astro:after-swap', () => {
		if (window.currentTheme) {
			applyTheme(window.currentTheme);
		}
	});
</script>
