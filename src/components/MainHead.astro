---
import '../styles/global.css';
import {
	AGENT_SEARCH_CONFIG,
	ALT_SITE_URL,
	AUTHOR_NAME,
	AUTHOR_NICKNAME,
	AUTHOR_ROLE,
	AUTHOR_SKILLS,
	SITE_DESCRIPTION,
	SITE_URL,
	SOCIAL_LINKS,
} from '../consts';

type Props = {
	title?: string | undefined;
	description?: string | undefined;
	ogType?: 'website' | 'article' | undefined;
	ogImage?: string | undefined;
	articleData?: {
		publishDate: Date;
		updatedDate?: Date;
		tags?: string[];
		author?: string;
	} | undefined;
	customJsonLD?: Record<string, unknown> | Record<string, unknown>[] | undefined;
	noindex?: boolean | undefined;
	markdownPath?: string | false | undefined;
}

const {
	title = `${AUTHOR_NICKNAME} (${AUTHOR_NAME})`,
	description = SITE_DESCRIPTION,
	ogType = 'website',
	ogImage = '/og-image.webp',
	articleData,
	customJsonLD,
	noindex = false,
	markdownPath,
} = Astro.props;

const normalizedPath = Astro.url.pathname.replace(/(.)\/+$/, '$1');
const canonicalURL = new URL(normalizedPath, SITE_URL);
const resolvedMarkdownPath = noindex || markdownPath === false
	? null
	: markdownPath ?? (normalizedPath === '/' ? '/index.md' : `${normalizedPath}.md`);
const siteURL = SITE_URL;

const personEntity = {
	"@type": "Person",
	"@id": `${siteURL}/#person`,
	"name": AUTHOR_NAME,
	"alternateName": AUTHOR_NICKNAME,
	"url": siteURL,
	"description": SITE_DESCRIPTION,
	"image": new URL('/og-image.webp', siteURL).toString(),
	"jobTitle": AUTHOR_ROLE,
	"email": `mailto:${SOCIAL_LINKS.email}`,
	"knowsAbout": [...AUTHOR_SKILLS],
	"worksFor": {
		"@type": "Organization",
		"name": "Independent / Available for Hire"
	},
	"sameAs": [
		SOCIAL_LINKS.github,
		SOCIAL_LINKS.twitter,
		SOCIAL_LINKS.linkedin,
		SOCIAL_LINKS.bluesky,
		SOCIAL_LINKS.npm,
		ALT_SITE_URL,
	],
	"address": {
		"@type": "PostalAddress",
		"addressRegion": "Gujarat",
		"addressCountry": "India"
	}
};

const extraEntities = customJsonLD
	? (Array.isArray(customJsonLD) ? customJsonLD : [customJsonLD])
	: [];

let jsonLD: Record<string, unknown>;

if (ogType === 'article' && articleData) {
	const blogPostingEntity: Record<string, unknown> = {
		"@type": "BlogPosting",
		"headline": title,
		"description": description,
		"image": new URL(ogImage, siteURL).toString(),
		"author": {
			"@id": `${siteURL}/#person`
		},
		"datePublished": articleData.publishDate.toISOString(),
		"dateModified": (articleData.updatedDate ?? articleData.publishDate).toISOString(),
		"url": canonicalURL.toString(),
		"mainEntityOfPage": {
			"@type": "WebPage",
			"@id": canonicalURL.toString()
		},
		"publisher": {
			"@id": `${siteURL}/#person`
		},
	};
	if (articleData.tags?.length) {
		blogPostingEntity.keywords = articleData.tags.join(', ');
	}
	jsonLD = {
		"@context": "https://schema.org",
		"@graph": [personEntity, blogPostingEntity, ...extraEntities],
	};
} else {
	const websiteEntity = {
		"@type": "WebSite",
		"@id": `${siteURL}/#website`,
		"name": `${AUTHOR_NICKNAME} (${AUTHOR_NAME})`,
		"url": siteURL,
		"description": SITE_DESCRIPTION,
		"publisher": {
			"@id": `${siteURL}/#person`
		},
		"potentialAction": {
			"@type": "SearchAction",
			"target": {
				"@type": "EntryPoint",
				"urlTemplate": `${siteURL}/.well-known/search?q={search_term_string}`
			},
			"query-input": "required name=search_term_string"
		},
	};
	jsonLD = {
		"@context": "https://schema.org",
		"@graph": [websiteEntity, personEntity, ...extraEntities],
	};
}
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
<meta name="googlebot" content={noindex ? 'noindex, follow' : 'index, follow'} />
<meta name="theme-color" content="#1a1a2e" />
<meta name="color-scheme" content="light dark" />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={AUTHOR_NAME} />
<meta name="keywords" content={`${AUTHOR_NAME}, ${AUTHOR_NICKNAME}, developer, full-stack, Gujarat, India, JavaScript, TypeScript, web development`} />
{!noindex && <link rel="canonical" href={canonicalURL} />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={AUTHOR_NICKNAME} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={new URL(ogImage, siteURL)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />

{ogType === 'article' && articleData && (
    <>
        <meta property="article:published_time" content={articleData.publishDate.toISOString()} />
        {articleData.updatedDate && (
            <meta property="article:modified_time" content={articleData.updatedDate.toISOString()} />
        )}
        {articleData.author && <meta property="article:author" content={articleData.author} />}
        {articleData.tags?.map(tag => (
            <meta property="article:tag" content={tag} />
        ))}
    </>
)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SOCIAL_LINKS.twitter.replace('https://x.com/', '@')} />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(ogImage, siteURL)} />
<meta name="twitter:creator" content={SOCIAL_LINKS.twitter.replace('https://x.com/', '@')} />

<!-- Favicon & Icons -->
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/favicon.ico" />

<!-- Sitemap & Discovery -->
<link rel="sitemap" type="application/xml" href="/sitemap.xml" />
<link rel="author" href="/llms.txt" />
<link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
<link rel="alternate" type="text/plain" title="llms-full.txt" href="/llms-full.txt" />
<link rel="ai-catalog" href="/.well-known/ai-catalog.json" />
{resolvedMarkdownPath && <link rel="alternate" type="text/markdown" title="Markdown version" href={resolvedMarkdownPath} />}

<!-- Search for Agents (Cloudflare /.well-known/search) -->
<meta name="agent:instructions" content={AGENT_SEARCH_CONFIG.instructions} />
<meta name="agent:endpoint" content={AGENT_SEARCH_CONFIG.endpoint} />
<meta name="agent:method" content={AGENT_SEARCH_CONFIG.method} />
<meta name="agent:documentation" content={AGENT_SEARCH_CONFIG.documentation} />

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLD)} />

<link
	id="daisyui-theme"
	rel="stylesheet"
	href="https://cdn.jsdelivr.net/npm/daisyui@5/theme/garden.css"
	data-astro-transition-persist="theme-link"
/>

<script is:inline>
	const DAISYUI_THEMES = [
		'abyss', 'acid', 'aqua', 'autumn', 'black', 'bumblebee', 'business',
		'caramellatte', 'cmyk', 'coffee', 'corporate', 'cupcake', 'cyberpunk',
		'dark', 'dim', 'dracula', 'emerald', 'fantasy', 'forest', 'garden',
		'halloween', 'lemonade', 'light', 'lofi', 'luxury', 'night', 'nord',
		'pastel', 'retro', 'silk', 'sunset', 'synthwave', 'valentine', 'winter', 'wireframe'
	];

	function applyTheme(theme) {
		const themeLink = document.getElementById('daisyui-theme');
		if (themeLink) {
			themeLink.href = `https://cdn.jsdelivr.net/npm/daisyui@5/theme/${theme}.css`;
		}
		document.documentElement.setAttribute('data-theme', theme);
		window.currentTheme = theme;
	}

	function initTheme() {
		const savedTheme = localStorage.getItem('savedTheme');
		if (savedTheme && DAISYUI_THEMES.includes(savedTheme)) {
			applyTheme(savedTheme);
			return;
		}

		if (window.currentTheme && DAISYUI_THEMES.includes(window.currentTheme)) {
			applyTheme(window.currentTheme);
			return;
		}

		const randomTheme = DAISYUI_THEMES[Math.floor(Math.random() * DAISYUI_THEMES.length)];
		applyTheme(randomTheme);
	}

	function updateSaveIcon(isSaved) {
		document.querySelectorAll('.save-icon').forEach(el => el.classList.toggle('hidden', isSaved));
		document.querySelectorAll('.saved-icon').forEach(el => el.classList.toggle('hidden', !isSaved));
	}

	function randomizeTheme() {
		const availableThemes = DAISYUI_THEMES.filter(theme => theme !== window.currentTheme);
		const randomTheme = availableThemes[Math.floor(Math.random() * availableThemes.length)];
		applyTheme(randomTheme);
		localStorage.removeItem('savedTheme');
		updateSaveIcon(false);
	}

	function saveTheme() {
		if (window.currentTheme) {
			localStorage.setItem('savedTheme', window.currentTheme);
			updateSaveIcon(true);
		}
	}

	initTheme();

	if (!window.siteThemeActionsBound) {
		document.addEventListener('site:randomize-theme', randomizeTheme);
		document.addEventListener('site:save-theme', saveTheme);
		window.siteThemeActionsBound = true;
	}

	document.addEventListener('astro:page-load', () => {
		const savedTheme = localStorage.getItem('savedTheme');
		updateSaveIcon(!!(savedTheme && savedTheme === window.currentTheme));
	});

	document.addEventListener('astro:after-swap', () => {
		if (window.currentTheme) {
			applyTheme(window.currentTheme);
		}
	});
</script>
