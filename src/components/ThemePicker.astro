---
import { Icon } from 'astro-icon/components';

---

<div class="flex items-center gap-1">
	<button
		id="random-theme-btn"
		class="btn btn-ghost btn-sm gap-2 px-2"
		data-theme-action="randomize"
		aria-label="Random theme (D)"
		title="Random theme (D)"
	>
		<Icon name="lucide:palette" size={18} />
		<kbd class="kbd kbd-xs" aria-hidden="true">D</kbd>
	</button>

	<button
		id="save-theme-btn"
		class="btn btn-ghost btn-sm gap-2 px-2"
		data-theme-action="save"
		aria-label="Save theme (S)"
		title="Save current theme (S)"
	>
		<Icon name="lucide:bookmark" size={18} class="save-icon" />
		<Icon name="lucide:bookmark-check" size={18} class="saved-icon hidden" />
		<kbd class="kbd kbd-xs" aria-hidden="true">S</kbd>
	</button>
</div>
