---
import { ClientRouter } from 'astro:transitions';

import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import MainHead from '../components/MainHead.astro';
import SearchModal from '../components/SearchModal.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ThemePicker from '../components/ThemePicker.astro';

const {title, description, ogType, ogImage, articleData, customJsonLD, noindex, markdownPath} = Astro.props;
const {showGlobalThemePicker = true} = Astro.props;
---

<html lang='en' class='h-full scroll-smooth bg-base-200 text-base-content'>
  <head>
    <MainHead title={title} description={description} ogType={ogType} ogImage={ogImage} articleData={articleData} customJsonLD={customJsonLD} noindex={noindex} markdownPath={markdownPath} />
    <GoogleAnalytics />
    <ClientRouter />
  </head>
  <body class='min-h-dvh flex flex-col font-[Inter_Tight] container mx-auto'>
    <div class='fixed top-4 right-4 z-50 flex items-center gap-1'>
      <SearchModal />
      {showGlobalThemePicker && <ThemePicker />}
    </div>
    <Fragment set:html={'<!--email_off-->'} />
    <slot />
    <Fragment set:html={'<!--/email_off-->'} />
    <SiteFooter />
    <script src='../scripts/keyboard-shortcuts.ts'></script>
  </body>
</html>
