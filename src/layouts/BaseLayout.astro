---
import { ClientRouter } from 'astro:transitions';

import MainHead from '../components/MainHead.astro';
import ThemePicker from '../components/ThemePicker.astro';

const {title, description, ogType, ogImage, articleData} = Astro.props;
const {showGlobalThemePicker = true} = Astro.props;
---

<html lang='en' class='h-full scroll-smooth bg-base-200 text-base-content'>
  <head>
    <MainHead title={title} description={description} ogType={ogType} ogImage={ogImage} articleData={articleData} />
    <ClientRouter />
  </head>
  <body class='min-h-full font-[Inter_Tight] container mx-auto'>
    {showGlobalThemePicker && (
      <div class='fixed top-4 right-4 z-50'>
        <ThemePicker />
      </div>
    )}
    <slot />
    <script src='../scripts/keyboard-shortcuts.ts'></script>
  </body>
</html>
