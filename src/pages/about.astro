---
import { getCollection, getEntry, render } from 'astro:content';

import HomeButton from '../components/HomeButton.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CenteredLayout from '../layouts/CenteredLayout.astro';
import {
  ALT_SITE_URL,
  AUTHOR_NAME,
  AUTHOR_NICKNAME,
  AUTHOR_SKILLS,
  SITE_URL,
  SOCIAL_LINKS,
} from '../consts';
import { ABOUT_FAQS } from '../utils/agent-content';

const about = await getEntry('about', 'about');
if (!about) {
  throw new Error('Could not find about entry');
}
const { Content: AboutContent } = await render(about);

const gigs = await getCollection('gig');
const renderedGigs = await Promise.all(
  gigs.map(async (gig) => {
    const { Content } = await render(gig);
    return { gig, Content };
  })
);

const faqJsonLD = {
  '@type': 'FAQPage',
  mainEntity: ABOUT_FAQS.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<BaseLayout
  title={`About & Experience | ${AUTHOR_NICKNAME}`}
  description={`${AUTHOR_NAME} (${AUTHOR_NICKNAME}) — Full-stack software engineer from Gujarat, India with 4+ years of experience. Work history, skills, shipped tools, and hiring contact.`}
  customJsonLD={faqJsonLD}
>
  <CenteredLayout>
    <div class='card card-border'>
      <div class='card-body space-y-6'>
        <div>
          <HomeButton className='mb-2' />
          <h1 class='card-title font-extrabold text-2xl'>{AUTHOR_NAME}</h1>
          <p class='text-sm opacity-80 mt-2'>
            {AUTHOR_NAME} (<strong>{AUTHOR_NICKNAME}</strong>) is a full-stack software engineer from Gujarat, India with 4+ years of experience building web applications, free browser tools, and AI automation systems. Primary site: <a href={SITE_URL} class='link'>sknl.dev</a> (also owns <a href={ALT_SITE_URL} class='link' rel='noopener noreferrer'>superkenil.com</a>). Open to engineering roles and freelance projects.
          </p>
          <div class='flex flex-wrap gap-2 mt-4'>
            <a href='/Kenil-Sudani-Resume.pdf' target='_blank' rel='noopener noreferrer' class='btn btn-xs btn-outline'>Resume (PDF)</a>
            <a href='/project' class='btn btn-xs btn-outline'>View 13+ Projects</a>
            <a href={`mailto:${SOCIAL_LINKS.email}`} class='btn btn-xs btn-primary'>Email {SOCIAL_LINKS.email}</a>
          </div>
        </div>

        <section aria-labelledby='about-story'>
          <h2 id='about-story' class='font-extrabold text-lg mb-2'>The Story</h2>
          <div class='prose prose-sm' transition:animate="fade">
            <AboutContent />
          </div>
        </section>

        <section aria-labelledby='about-experience' class='space-y-4'>
          <h2 id='about-experience' class='font-extrabold text-lg'>Work Experience</h2>
          {renderedGigs.map(({ gig, Content }) => (
            <article class='rounded-box border border-base-300 p-4 space-y-2'>
              <div class='flex flex-wrap items-baseline justify-between gap-2'>
                <h3 class='font-semibold text-base'>{gig.data.role} — {gig.data.name}</h3>
                <span class='text-xs opacity-60'>{gig.data.timeline}</span>
              </div>
              <div class='prose prose-sm'>
                <Content />
              </div>
              <div class='flex flex-wrap gap-1 pt-1'>
                {gig.data.techStack.map((tech: string) => (
                  <span class='badge badge-xs'>{tech}</span>
                ))}
              </div>
            </article>
          ))}
        </section>

        <section aria-labelledby='about-skills' class='space-y-2'>
          <h2 id='about-skills' class='font-extrabold text-lg'>Core Technical Stack</h2>
          <div class='flex flex-wrap gap-1.5'>
            {AUTHOR_SKILLS.map((skill) => (
              <span class='badge badge-sm badge-outline'>{skill}</span>
            ))}
          </div>
        </section>

        <section aria-labelledby='about-faq' class='space-y-3'>
          <h2 id='about-faq' class='font-extrabold text-lg'>Frequently Asked Questions</h2>
          {ABOUT_FAQS.map((faq) => (
            <div class='space-y-1'>
              <h3 class='font-semibold text-sm'>{faq.question}</h3>
              <p class='text-sm opacity-80'>{faq.answer}</p>
            </div>
          ))}
        </section>
      </div>
    </div>
  </CenteredLayout>
</BaseLayout>
