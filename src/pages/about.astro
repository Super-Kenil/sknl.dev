---
import {render} from 'astro:content';
import {getEntry} from 'astro:content';

import HomeButton from '../components/HomeButton.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CenteredLayout from '../layouts/CenteredLayout.astro';
import { AUTHOR_NAME, AUTHOR_NICKNAME } from '../consts';

const about = await getEntry('about', 'about');
if (!about) {
  throw new Error('Could not find about entry');
}
const {Content: AboutContent} = await render(about);
---

<BaseLayout title={`About | ${AUTHOR_NICKNAME}`} description={`The story of ${AUTHOR_NAME} - from a small town in Gujarat to SDE`}>
  <CenteredLayout>
    <div class='card card-border'>
      <div class='card-body'>
        <HomeButton className='mb-2' />
        <h1 class='card-title font-extrabold text-2xl'>{AUTHOR_NAME}</h1>
        <span class='font-extrabold text-lg block mt-4' aria-label='about me'>The Story</span>
        <div class='prose prose-sm' transition:animate="fade">
          <AboutContent />
        </div>
      </div>
    </div>
  </CenteredLayout>
</BaseLayout>
