---
import {getCollection, render} from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeButton from '../../components/HomeButton.astro';
import { Icon } from 'astro-icon/components'

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} | Super Kenil`}
  description={post.data.description}
  ogType="article"
  ogImage={`/blog/${post.id}.png`}
  articleData={{
    publishDate: post.data.date,
    tags: post.data.tags,
    author: "Kenil Sudani"
  }}
>
  <main class='flex flex-col mx-auto py-12 max-w-2xl px-4'>
    <article>
      <header class='mb-8'>
        <a href='/blog' class='link link-hover text-sm opacity-80 mb-4 inline-flex gap-x-1 items-center' transition:animate="fade"><Icon name='lucide:arrow-left' /> Back to posts</a>
        <h1 class='text-3xl font-bold mb-2' transition:name={`blog-post-${post.id}`}>{post.data.title}</h1>
        <p class='text-sm opacity-70 mb-2' transition:name={`blog-desc-${post.id}`}>{post.data.description}</p>
        <div class='flex items-center gap-3 text-sm opacity-70'>
          <time datetime={post.data.date.toISOString()} transition:name={`blog-date-${post.id}`}>
            {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          {post.data.tags && (
            <div class='flex gap-1' transition:name={`blog-tags-${post.id}`}>
              {post.data.tags.map((tag: string) => (
                <span class='badge badge-xs'>{tag}</span>
              ))}
            </div>
          )}
        </div>
      </header>

      <div class='prose prose-sm' transition:animate="fade">
        <Content />
      </div>
    </article>

    <div class='divider my-8' transition:animate="fade"></div>
    <HomeButton className='w-fit' />
  </main>
</BaseLayout>
