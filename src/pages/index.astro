---
import {Icon} from 'astro-icon/components';

import BaseLayout from '../layouts/BaseLayout.astro';
import CenteredLayout from '../layouts/CenteredLayout.astro';
import GitHubContributions from '../components/GitHubContributions.astro';
import ThemePicker from '../components/ThemePicker.astro';
import { AUTHOR_NAME, AUTHOR_NICKNAME, SITE_DESCRIPTION, SOCIAL_LINKS } from '../consts';

const socialLinks = [
  { href: SOCIAL_LINKS.twitter, label: 'X (Twitter)', icon: 'ri:twitter-x-fill', external: true },
  { href: SOCIAL_LINKS.github, label: 'GitHub', icon: 'lucide:github', external: true },
  { href: SOCIAL_LINKS.linkedin, label: 'LinkedIn', icon: 'lucide:linkedin', external: true },
  { href: SOCIAL_LINKS.bluesky, label: 'Bluesky', icon: 'ri:bluesky-line', external: true },
  { href: SOCIAL_LINKS.npm, label: 'npm', icon: 'ri:npmjs-line', external: true },
  { href: `mailto:${SOCIAL_LINKS.email}`, label: 'Email', icon: 'lucide:mail', external: false },
] as const;
---

<BaseLayout title={`${AUTHOR_NICKNAME} (${AUTHOR_NAME})`} description={SITE_DESCRIPTION} showGlobalThemePicker={false}>
  <CenteredLayout>
    <div class='card card-border max-w-full'>
      <div class='card-body min-w-0'>
        <div class='flex items-center justify-between'>
          <h1 class='card-title font-extrabold text-2xl'>{AUTHOR_NAME}</h1>
          <ThemePicker />
        </div>
        <p transition:animate="fade">Friendly Neighbourhood Nerd</p>

        <p class='text-sm opacity-75 mt-2' transition:animate="fade">
          Full-stack developer from Gujarat, India. I build free browser tools, open-source developer utilities, and AI automation systems—open to engineering roles and freelance inquiries. Mostly posting on <a href={SOCIAL_LINKS.twitter} target='_blank' rel='noopener noreferrer' class='link'>X (Twitter)</a>.
        </p>

        <div class='divider invisible'></div>

        <div class='overflow-x-auto w-xs max-w-dvw'>
          <ul class='list rounded-box space-y-4'>
            <li class='group'>
              <a href='/about' class='link link-hover flex items-start justify-between' aria-keyshortcuts='1' data-keyboard-shortcut='1'>
                <span>
                  The Story
                  <span class='block text-xs opacity-60'>Background, work experience &amp; hiring info</span>
                </span>
                <span class='flex items-center gap-2'>
                  <kbd class='kbd kbd-xs' aria-hidden='true'>1</kbd>
                  <Icon name='lucide:chevron-right' class='invisible group-hover:visible opacity-70' size={16} />
                </span>
              </a>
            </li>
            <li class='group'>
              <a href='/project' class='link link-hover flex items-start justify-between' aria-keyshortcuts='2' data-keyboard-shortcut='2'>
                <span>
                  <span transition:name="project-title">Current Benchmarks I'm Trying To Surpass</span>
                  <span class='block text-xs opacity-60'>Free web tools, OSS utilities &amp; shipped products</span>
                </span>
                <span class='flex items-center gap-2'>
                  <kbd class='kbd kbd-xs' aria-hidden='true'>2</kbd>
                  <Icon name='lucide:chevron-right' class='invisible group-hover:visible opacity-70' size={16} />
                </span>
              </a>
            </li>
            <li class='group'>
              <a href='/blog' class='link link-hover flex items-start justify-between' aria-keyshortcuts='3' data-keyboard-shortcut='3'>
                <span>
                  <span transition:name="blog-title">I Tried Writing</span>
                  <span class='block text-xs opacity-60'>Technical articles on TypeScript, React, Bun &amp; AI</span>
                </span>
                <span class='flex items-center gap-2'>
                  <kbd class='kbd kbd-xs' aria-hidden='true'>3</kbd>
                  <Icon name='lucide:chevron-right' class='invisible group-hover:visible opacity-70' size={16} />
                </span>
              </a>
            </li>
          </ul>
        </div>

        <div class='flex flex-wrap items-center gap-2 mt-4'>
          <a href='/Kenil-Sudani-Resume.pdf' target='_blank' rel='noopener noreferrer' class='btn btn-xs btn-outline'>Resume (PDF)</a>
          <a href={`mailto:${SOCIAL_LINKS.email}`} class='btn btn-xs btn-primary'>Contact</a>
        </div>

        <div class='divider'></div>

        <GitHubContributions />

        <div class='divider'></div>

        <div class='flex flex-wrap gap-3 justify-center' transition:animate="fade">
          {
            socialLinks.map(({ href, label, icon, external }) => (
              <div class='tooltip' data-tip={label}>
                <a
                  href={href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                  class='btn btn-sm btn-ghost'
                  aria-label={label}
                >
                  <Icon name={icon} size={18} aria-hidden='true' />
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </CenteredLayout>
</BaseLayout>
