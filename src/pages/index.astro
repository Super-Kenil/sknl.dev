---
import {Icon} from 'astro-icon/components';

import BaseLayout from '../layouts/BaseLayout.astro';
import CenteredLayout from '../layouts/CenteredLayout.astro';
import ThemePicker from '../components/ThemePicker.astro';
import { AUTHOR_NAME, AUTHOR_NICKNAME, SITE_DESCRIPTION, SOCIAL_LINKS } from '../consts';
---

<BaseLayout title={`${AUTHOR_NICKNAME} (${AUTHOR_NAME})`} description={SITE_DESCRIPTION}>
  <CenteredLayout>
    <div class='card card-border'>
      <div class='card-body'>
        <div class='flex items-center justify-between'>
          <h1 class='card-title font-extrabold text-2xl'>{AUTHOR_NAME}</h1>
          <ThemePicker />
        </div>
        <p transition:animate="fade">Friendly Neighbourhood Nerd</p>

        <p class='text-sm opacity-75 mt-2' transition:animate="fade">Full-stack developer from Gujarat. I build tools that solve real problems and occasionally write about what I learn. Mostly posting on <a href={SOCIAL_LINKS.twitter} target='_blank' rel='noopener noreferrer' class='link'>X (Twitter)</a>.</p>

        <div class='divider invisible'></div>

        <div class='overflow-x-auto w-xs max-w-dvw'>
          <ul class='list rounded-box space-y-4'>
            <li class='group'>
              <a href='/about' class='link link-hover flex items-start justify-between'>
                <span>The Story</span>
                <Icon name='lucide:chevron-right' class='invisible group-hover:visible opacity-70' size={16} />
              </a>
            </li>
            <li class='group'>
              <a href='/project' class='link link-hover flex items-start justify-between'>
                <span transition:name="project-title">Current Benchmarks I'm Trying To Surpass</span>
                <Icon name='lucide:chevron-right' class='invisible group-hover:visible opacity-70' size={16} />
              </a>
            </li>
            <li class='group'>
              <a href='/blog' class='link link-hover flex items-start justify-between'>
                <span transition:name="blog-title">I Tried Writing</span>
                <Icon name='lucide:chevron-right' class='invisible group-hover:visible opacity-70' size={16} />
              </a>
            </li>
          </ul>
        </div>

        <div class='divider'></div>

        <div class='flex flex-wrap gap-3 justify-center' transition:animate="fade">
          <a href={SOCIAL_LINKS.github} target='_blank' rel='noopener noreferrer' class='btn btn-sm btn-ghost' aria-label='GitHub'>
            <Icon name='lucide:github' size={18} />
          </a>
          <a href={SOCIAL_LINKS.twitter} target='_blank' rel='noopener noreferrer' class='btn btn-sm btn-ghost' aria-label='X (Twitter)'>
            <Icon name='ri:twitter-x-fill' size={18} />
          </a>
          <a href={SOCIAL_LINKS.linkedin} target='_blank' rel='noopener noreferrer' class='btn btn-sm btn-ghost' aria-label='LinkedIn'>
            <Icon name='lucide:linkedin' size={18} />
          </a>
          <a href={SOCIAL_LINKS.bluesky} target='_blank' rel='noopener noreferrer' class='btn btn-sm btn-ghost' aria-label='Bluesky'>
            <Icon name='ri:bluesky-line' size={18} />
          </a>
          <a href={SOCIAL_LINKS.npm} target='_blank' rel='noopener noreferrer' class='btn btn-sm btn-ghost' aria-label='npm'>
            <Icon name='ri:npmjs-line' size={18} />
          </a>
          <a href={`mailto:${SOCIAL_LINKS.email}`} class='btn btn-sm btn-ghost' aria-label='Email'>
            <Icon name='lucide:mail' size={18} />
          </a>
        </div>
      </div>
    </div>
  </CenteredLayout>
</BaseLayout>
