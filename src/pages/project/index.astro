---
import {getCollection} from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {Image} from 'astro:assets';
import {Icon} from 'astro-icon/components';
import HomeButton from '../../components/HomeButton.astro';

const projects = (await getCollection('project')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <main class='flex flex-col mx-auto py-12'>
    <div class='grid grid-cols-1 md:grid-cols-2 gap-6 mx-auto'>
      <div class='flex flex-col col-span-2 gap-2'>
        <HomeButton className='w-fit mt-6 mb-2' />
        <h1 class='text-2xl'>My Projects</h1>
        <p transition:name="project-title">Current Benchmarks I'm Trying To Surpass</p>
      </div>
      {
        projects.map(({data: project}, index) => (
          <div
            class='card card-sm card-border bg-base-100 border-base-300 w-72 animate-slideup'
            style={`animation-delay: ${index * 100}ms`}
          >
            <div class='avatar mx-auto p-4'>
              <div class='w-40 rounded'>
                <Image src={project.image} width={140} height={80} class='rounded-[calc(var(--radius-box)-.5rem)]' alt={project.title} />
              </div>
            </div>
            <div class='card-body gap-4'>
              <h2 class='flex items-center justify-between'>
                <span class='font-semibold text-lg'>{project.title}</span>
                <div class='flex items-center gap-x-2'>
                  {project.url && (
                    <a href={project.url} target='_blank' rel='noopener noreferrer' class='btn btn-square btn-sm'>
                      <Icon name='lucide:globe' size={16} />
                    </a>
                  )}
                  {project.gitUrl && (
                    <a href={project.gitUrl} target='_blank' rel='noopener noreferrer' class='btn btn-square btn-sm'>
                      <Icon name='lucide:github' size={16} />
                    </a>
                  )}
                </div>
              </h2>
              <p>{project.description}</p>
              <div class='flex items-center gap-x-2'>
                {project.techStack.map((s: string) => (
                  <span class='badge badge-xs'>{s}</span>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </main>
</BaseLayout>

<style>
  @keyframes slideup {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-slideup {
    opacity: 0;
    animation: slideup 0.6s ease-out forwards;
  }
</style>
